<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg_gold"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="8dp">

    <TextView
        android:id="@+id/tv_prayer_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="المغرب"
        android:textColor="#FFFFFF"
        android:textSize="20sp"
        android:textStyle="bold"
        android:layout_marginBottom="2dp"/>

    <TextView
        android:id="@+id/tv_prayer_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="06:16 م"
        android:textColor="#B89B5E"
        android:textSize="14sp"
        android:textStyle="bold"
        android:layout_marginBottom="6dp"/>

    <FrameLayout
        android:layout_width="40dp"
        android:layout_height="1dp"
        android:background="#33B89B5E"
        android:layout_marginBottom="6dp" />

    <Chronometer
        android:id="@+id/chronometer_remaining"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="#FFFFFF"
        android:textSize="18sp"
        android:textStyle="bold"
        android:countDown="true" />

</LinearLayout>